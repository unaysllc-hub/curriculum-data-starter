{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unays.net/schemas/curriculum-v1.json",
  "title": "Open Curriculum Dataset",
  "type": "object",
  "required": ["title", "version", "language", "grades"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "license": {"type": "string"},
    "source": {"type": "string", "format": "uri"},
    "grades": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/grade"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "grade": {
      "type": "object",
      "required": ["id", "name", "subjects"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["id", "name", "terms"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/term"}}
      },
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "required": ["id", "name", "strands"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "strands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/strand"}}
      },
      "additionalProperties": false
    },
    "strand": {
      "type": "object",
      "required": ["id", "name", "units"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "required": ["id", "title", "objectives"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "estimatedMinutes": {"type": "integer", "minimum": 1},
        "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}
